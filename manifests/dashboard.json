{
  "title": "CENTRA10 \u2014 autoscaling LLM",
  "uid": "centra10-llm",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ready replicas, waiting/running requests, completed QPS",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "ready",
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"centra10\",deployment=\"vllm\"})",
          "legendFormat": "ready"
        },
        {
          "refId": "queue",
          "expr": "sum(vllm:num_requests_waiting{namespace=\"centra10\",service=\"vllm\"})",
          "legendFormat": "queue"
        },
        {
          "refId": "running",
          "expr": "sum(vllm:num_requests_running{namespace=\"centra10\",service=\"vllm\"})",
          "legendFormat": "running"
        },
        {
          "refId": "qps",
          "expr": "sum(rate(vllm:request_success_total{namespace=\"centra10\",service=\"vllm\"}[1m]))",
          "legendFormat": "qps"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "qps"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Maximum replica KV-cache usage (if available)",
      "description": "No data means unavailable, not zero usage. Verify the metric name on the deployed vLLM version.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "kv_cache",
          "expr": "max(vllm:kv_cache_usage_perc{namespace=\"centra10\",service=\"vllm\"})",
          "legendFormat": "max KV-cache usage"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    }
  ],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ]
}
